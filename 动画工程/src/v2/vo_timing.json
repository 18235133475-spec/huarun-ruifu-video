{
 "A1": {
  "speechStart": 0.235,
  "speechEnd": 4.799,
  "segs": [
   {
    "text": "汾河边有个小区，",
    "start": 0.235,
    "end": 1.246
   },
   {
    "text": "二十多栋楼排得整整齐齐，",
    "start": 1.555,
    "end": 3.526
   },
   {
    "text": "都是正南正北。",
    "start": 3.791,
    "end": 4.799
   }
  ]
 },
 "A2": {
  "speechStart": 0.223,
  "speechEnd": 5.838,
  "segs": [
   {
    "text": "最北边的两栋，",
    "start": 0.223,
    "end": 1.147
   },
   {
    "text": "却转了个身，",
    "start": 1.396,
    "end": 2.12
   },
   {
    "text": "一起转向了西南。",
    "start": 2.374,
    "end": 3.673
   },
   {
    "text": "不是画错了，",
    "start": 4.368,
    "end": 5.03
   },
   {
    "text": "是故意的。",
    "start": 5.292,
    "end": 5.838
   }
  ]
 },
 "A3": {
  "speechStart": 0.205,
  "speechEnd": 6.391,
  "segs": [
   {
    "text": "在太原看房，",
    "start": 0.205,
    "end": 1.057
   },
   {
    "text": "很多人问的第一句话是：",
    "start": 1.42,
    "end": 2.878
   },
   {
    "text": "朝南吗？",
    "start": 3.088,
    "end": 3.654
   },
   {
    "text": "放着正南不朝，",
    "start": 4.429,
    "end": 5.541
   },
   {
    "text": "它图什么？",
    "start": 5.793,
    "end": 6.391
   }
  ]
 },
 "A4": {
  "speechStart": 0.2,
  "speechEnd": 8.447,
  "segs": [
   {
    "text": "顺着它的正面看过去：",
    "start": 0.2,
    "end": 1.616
   },
   {
    "text": "前面是和园，",
    "start": 1.799,
    "end": 2.816
   },
   {
    "text": "再往远，",
    "start": 3.057,
    "end": 3.621
   },
   {
    "text": "是晋阳湖的方向；",
    "start": 3.869,
    "end": 5.02
   },
   {
    "text": "背后，",
    "start": 5.468,
    "end": 5.767
   },
   {
    "text": "是汾河，",
    "start": 5.986,
    "end": 6.622
   },
   {
    "text": "和沿河排开的五大馆。",
    "start": 6.931,
    "end": 8.447
   }
  ]
 },
 "A5": {
  "speechStart": 0.23,
  "speechEnd": 5.997,
  "segs": [
   {
    "text": "这栋楼，",
    "start": 0.23,
    "end": 0.715
   },
   {
    "text": "是太原瑞府的2号楼。",
    "start": 0.923,
    "end": 2.342
   },
   {
    "text": "355平方米的楼王户型，",
    "start": 3.008,
    "end": 4.84
   },
   {
    "text": "独占一个单元。",
    "start": 5.089,
    "end": 5.997
   }
  ]
 },
 "A6": {
  "speechStart": 0.264,
  "speechEnd": 7.641,
  "segs": [
   {
    "text": "我的结论是：",
    "start": 0.264,
    "end": 0.878
   },
   {
    "text": "太原三百多平的大平层，",
    "start": 1.06,
    "end": 2.666
   },
   {
    "text": "目前有了天花板。",
    "start": 2.96,
    "end": 4.013
   },
   {
    "text": "理由有四个：",
    "start": 4.691,
    "end": 5.371
   },
   {
    "text": "位置，",
    "start": 5.517,
    "end": 5.841
   },
   {
    "text": "楼栋，",
    "start": 6.134,
    "end": 6.435
   },
   {
    "text": "平面，",
    "start": 6.707,
    "end": 7.0
   },
   {
    "text": "耐心。",
    "start": 7.284,
    "end": 7.641
   }
  ]
 },
 "B1": {
  "speechStart": 0.237,
  "speechEnd": 11.924,
  "segs": [
   {
    "text": "面朝和园，",
    "start": 0.237,
    "end": 0.959
   },
   {
    "text": "远眺晋阳湖。",
    "start": 1.188,
    "end": 2.244
   },
   {
    "text": "近处的和园，",
    "start": 2.954,
    "end": 3.736
   },
   {
    "text": "草坪、树林、水系，",
    "start": 4.006,
    "end": 5.205
   },
   {
    "text": "一年四季都在变；",
    "start": 5.447,
    "end": 6.839
   },
   {
    "text": "楼层够高、天气够好，",
    "start": 6.95,
    "end": 8.502
   },
   {
    "text": "目光能一直走到晋阳湖的方向。",
    "start": 8.728,
    "end": 11.924
   }
  ]
 },
 "B2": {
  "speechStart": 0.22,
  "speechEnd": 4.936,
  "segs": [
   {
    "text": "背靠汾河和五大馆。",
    "start": 0.22,
    "end": 1.641
   },
   {
    "text": "白天，",
    "start": 2.322,
    "end": 2.72
   },
   {
    "text": "是一条河和一座城的轮廓；",
    "start": 2.926,
    "end": 4.936
   }
  ]
 },
 "B3": {
  "speechStart": 0.238,
  "speechEnd": 2.112,
  "segs": [
   {
    "text": "入夜，",
    "start": 0.238,
    "end": 0.577
   },
   {
    "text": "是整片亮起来的灯。",
    "start": 0.795,
    "end": 2.112
   }
  ]
 },
 "B4": {
  "speechStart": 0.199,
  "speechEnd": 7.763,
  "segs": [
   {
    "text": "西有西山，",
    "start": 0.199,
    "end": 0.931
   },
   {
    "text": "东有天际线。",
    "start": 1.108,
    "end": 3.008
   },
   {
    "text": "山、河、湖、园、馆、城，",
    "start": 3.343,
    "end": 5.02
   },
   {
    "text": "围着这栋楼排了一圈。",
    "start": 5.309,
    "end": 7.763
   }
  ]
 },
 "B5": {
  "speechStart": 0.213,
  "speechEnd": 5.037,
  "segs": [
   {
    "text": "它转过身，",
    "start": 0.213,
    "end": 0.834
   },
   {
    "text": "是把正面留给太原。",
    "start": 1.028,
    "end": 2.438
   },
   {
    "text": "这一转，",
    "start": 3.101,
    "end": 3.581
   },
   {
    "text": "是看，",
    "start": 3.755,
    "end": 4.141
   },
   {
    "text": "也是致敬。",
    "start": 4.444,
    "end": 5.037
   }
  ]
 },
 "B6": {
  "speechStart": 0.236,
  "speechEnd": 3.891,
  "segs": [
   {
    "text": "可很少有人想得起来，",
    "start": 0.236,
    "end": 1.429
   },
   {
    "text": "二十多年前，",
    "start": 1.786,
    "end": 2.496
   },
   {
    "text": "这里是一片田地。",
    "start": 2.756,
    "end": 3.891
   }
  ]
 },
 "B7": {
  "speechStart": 0.205,
  "speechEnd": 10.285,
  "segs": [
   {
    "text": "从图书馆走到大剧院，",
    "start": 0.205,
    "end": 1.679
   },
   {
    "text": "脚下那一大片平台，",
    "start": 2.047,
    "end": 3.305
   },
   {
    "text": "是整个抬起来的：",
    "start": 3.596,
    "end": 4.66
   },
   {
    "text": "车在下面跑，",
    "start": 4.853,
    "end": 5.788
   },
   {
    "text": "人在上面走；",
    "start": 6.147,
    "end": 6.991
   },
   {
    "text": "绕着场馆的那一圈水，",
    "start": 7.386,
    "end": 8.805
   },
   {
    "text": "是从汾河引进来的。",
    "start": 9.04,
    "end": 10.285
   }
  ]
 },
 "B8": {
  "speechStart": 0.216,
  "speechEnd": 8.081,
  "segs": [
   {
    "text": "给这片田地做整体规划的，",
    "start": 0.216,
    "end": 2.021
   },
   {
    "text": "是一家法国事务所。",
    "start": 2.233,
    "end": 3.542
   },
   {
    "text": "名字你可能没听过，",
    "start": 4.238,
    "end": 5.423
   },
   {
    "text": "它的作品你多半知道：",
    "start": 5.758,
    "end": 7.087
   },
   {
    "text": "上海大剧院。",
    "start": 7.251,
    "end": 8.081
   }
  ]
 },
 "B9": {
  "speechStart": 0.21,
  "speechEnd": 8.704,
  "segs": [
   {
    "text": "事务所的创始人夏邦杰，",
    "start": 0.21,
    "end": 1.743
   },
   {
    "text": "没能等到长风建成的那一天。",
    "start": 2.003,
    "end": 3.892
   },
   {
    "text": "他在2010年冬天去世；",
    "start": 4.572,
    "end": 6.364
   },
   {
    "text": "两年后，",
    "start": 6.79,
    "end": 7.247
   },
   {
    "text": "山西大剧院交付。",
    "start": 7.435,
    "end": 8.704
   }
  ]
 },
 "B10": {
  "speechStart": 0.338,
  "speechEnd": 6.115,
  "segs": [
   {
    "text": "二十多年过去，",
    "start": 0.338,
    "end": 1.094
   },
   {
    "text": "田地成了太原的门面。",
    "start": 1.335,
    "end": 2.727
   },
   {
    "text": "2号楼转身面对的，",
    "start": 3.529,
    "end": 4.681
   },
   {
    "text": "就是这样一片地方。",
    "start": 4.931,
    "end": 6.115
   }
  ]
 },
 "B11": {
  "speechStart": 0.236,
  "speechEnd": 7.832,
  "segs": [
   {
    "text": "不过，",
    "start": 0.236,
    "end": 0.466
   },
   {
    "text": "不是每一层、每一扇窗，",
    "start": 0.733,
    "end": 2.453
   },
   {
    "text": "都能把这些一次装进来。",
    "start": 2.758,
    "end": 4.117
   },
   {
    "text": "楼层不同，",
    "start": 4.843,
    "end": 5.491
   },
   {
    "text": "站的位置不同，",
    "start": 5.697,
    "end": 6.549
   },
   {
    "text": "看到的都不一样。",
    "start": 6.768,
    "end": 7.832
   }
  ]
 },
 "C1": {
  "speechStart": 0.306,
  "speechEnd": 7.795,
  "segs": [
   {
    "text": "2号楼分两个单元。",
    "start": 0.306,
    "end": 1.539
   },
   {
    "text": "一个单元，",
    "start": 2.244,
    "end": 2.776
   },
   {
    "text": "每层两套；",
    "start": 2.982,
    "end": 3.63
   },
   {
    "text": "另一个单元，",
    "start": 3.946,
    "end": 4.624
   },
   {
    "text": "每层只放一套，",
    "start": 4.868,
    "end": 5.893
   },
   {
    "text": "就是这套355平方米。",
    "start": 6.191,
    "end": 7.795
   }
  ]
 },
 "C2": {
  "speechStart": 0.198,
  "speechEnd": 6.572,
  "segs": [
   {
    "text": "电梯门一开，",
    "start": 0.198,
    "end": 0.958
   },
   {
    "text": "这一层没有邻居。",
    "start": 1.212,
    "end": 2.326
   },
   {
    "text": "两梯一户，",
    "start": 3.005,
    "end": 3.67
   },
   {
    "text": "两部电梯对着的，",
    "start": 3.963,
    "end": 5.029
   },
   {
    "text": "只是这一户的玄关。",
    "start": 5.358,
    "end": 6.572
   }
  ]
 },
 "C3": {
  "speechStart": 0.264,
  "speechEnd": 4.299,
  "segs": [
   {
    "text": "南面22.8米一整排，",
    "start": 0.264,
    "end": 1.956
   },
   {
    "text": "是这一家的客厅和三间卧室。",
    "start": 2.25,
    "end": 4.299
   }
  ]
 },
 "D1": {
  "speechStart": 0.204,
  "speechEnd": 8.167,
  "segs": [
   {
    "text": "第一眼看这张图，",
    "start": 0.204,
    "end": 1.341
   },
   {
    "text": "房间不少。",
    "start": 1.581,
    "end": 2.145
   },
   {
    "text": "记住两条线就够了：",
    "start": 2.892,
    "end": 4.196
   },
   {
    "text": "纵线，",
    "start": 4.41,
    "end": 4.775
   },
   {
    "text": "管看什么；",
    "start": 5.059,
    "end": 5.717
   },
   {
    "text": "横线，",
    "start": 6.222,
    "end": 6.583
   },
   {
    "text": "管和谁在一起。",
    "start": 6.894,
    "end": 8.167
   }
  ]
 },
 "D2": {
  "speechStart": 0.209,
  "speechEnd": 9.266,
  "segs": [
   {
    "text": "从客厅往北，",
    "start": 0.209,
    "end": 1.207
   },
   {
    "text": "是餐厅、茶区，",
    "start": 1.422,
    "end": 2.681
   },
   {
    "text": "前后相连，",
    "start": 2.925,
    "end": 3.688
   },
   {
    "text": "中间没有一道隔墙。",
    "start": 3.986,
    "end": 5.379
   },
   {
    "text": "南窗外是和园，",
    "start": 6.08,
    "end": 7.207
   },
   {
    "text": "北窗外是商务区和汾河。",
    "start": 7.562,
    "end": 9.266
   }
  ]
 },
 "D3": {
  "speechStart": 0.195,
  "speechEnd": 11.296,
  "segs": [
   {
    "text": "下午在客厅，",
    "start": 0.195,
    "end": 1.073
   },
   {
    "text": "看园；",
    "start": 1.351,
    "end": 1.79
   },
   {
    "text": "傍晚在餐厅，",
    "start": 2.146,
    "end": 2.989
   },
   {
    "text": "一张圆桌的人，",
    "start": 3.35,
    "end": 4.254
   },
   {
    "text": "看着同一个太原的两面；",
    "start": 4.544,
    "end": 6.014
   },
   {
    "text": "入夜到茶区，",
    "start": 6.478,
    "end": 7.34
   },
   {
    "text": "窗外换成了城市的灯。",
    "start": 7.605,
    "end": 9.023
   },
   {
    "text": "白天看园，",
    "start": 9.708,
    "end": 10.434
   },
   {
    "text": "晚上看城。",
    "start": 10.636,
    "end": 11.296
   }
  ]
 },
 "D4": {
  "speechStart": 0.242,
  "speechEnd": 4.576,
  "segs": [
   {
    "text": "站在窗前，",
    "start": 0.242,
    "end": 0.946
   },
   {
    "text": "是你在看风景；",
    "start": 1.147,
    "end": 2.2
   },
   {
    "text": "坐回厅里，",
    "start": 2.482,
    "end": 3.124
   },
   {
    "text": "是风景在陪你。",
    "start": 3.342,
    "end": 4.576
   }
  ]
 },
 "D5": {
  "speechStart": 0.201,
  "speechEnd": 9.916,
  "segs": [
   {
    "text": "玄关在中间。",
    "start": 0.201,
    "end": 1.13
   },
   {
    "text": "往东，",
    "start": 1.805,
    "end": 2.227
   },
   {
    "text": "是“聚”：",
    "start": 2.467,
    "end": 2.791
   },
   {
    "text": "客厅、餐厅、茶区、厨房；",
    "start": 2.981,
    "end": 4.862
   },
   {
    "text": "往西，",
    "start": 5.122,
    "end": 5.559
   },
   {
    "text": "是“私”：",
    "start": 5.895,
    "end": 6.331
   },
   {
    "text": "主卧、衣帽间、主卫，",
    "start": 6.608,
    "end": 8.443
   },
   {
    "text": "连成一组。",
    "start": 8.682,
    "end": 9.916
   }
  ]
 },
 "D6": {
  "speechStart": 0.208,
  "speechEnd": 6.673,
  "segs": [
   {
    "text": "起床，",
    "start": 0.208,
    "end": 0.639
   },
   {
    "text": "挑衣服，",
    "start": 0.837,
    "end": 1.341
   },
   {
    "text": "洗漱，",
    "start": 1.618,
    "end": 1.991
   },
   {
    "text": "出门；",
    "start": 2.224,
    "end": 2.599
   },
   {
    "text": "晚上反过来走一遍。",
    "start": 2.91,
    "end": 4.089
   },
   {
    "text": "主卧的窗朝南，",
    "start": 4.756,
    "end": 5.784
   },
   {
    "text": "对着和园。",
    "start": 6.015,
    "end": 6.673
   }
  ]
 },
 "D7": {
  "speechStart": 0.229,
  "speechEnd": 8.516,
  "segs": [
   {
    "text": "南面一整排留给住，",
    "start": 0.229,
    "end": 1.547
   },
   {
    "text": "北面一整排留给用；",
    "start": 1.964,
    "end": 3.265
   },
   {
    "text": "东边聚，",
    "start": 3.681,
    "end": 4.205
   },
   {
    "text": "西边私。",
    "start": 4.481,
    "end": 5.067
   },
   {
    "text": "这355平方米，",
    "start": 5.743,
    "end": 7.069
   },
   {
    "text": "多出来的是选择。",
    "start": 7.331,
    "end": 8.516
   }
  ]
 },
 "E1": {
  "speechStart": 0.207,
  "speechEnd": 9.588,
  "segs": [
   {
    "text": "据了解，",
    "start": 0.207,
    "end": 0.704
   },
   {
    "text": "在瑞府，",
    "start": 0.95,
    "end": 1.308
   },
   {
    "text": "270平方米以上的大户型，",
    "start": 1.427,
    "end": 3.599
   },
   {
    "text": "几乎每加推一次，",
    "start": 3.923,
    "end": 5.092
   },
   {
    "text": "就新开一个样板间。",
    "start": 5.314,
    "end": 6.616
   },
   {
    "text": "每一批大户型，",
    "start": 7.285,
    "end": 8.185
   },
   {
    "text": "都重新想过一遍。",
    "start": 8.382,
    "end": 9.588
   }
  ]
 },
 "E2": {
  "speechStart": 0.419,
  "speechEnd": 8.576,
  "segs": [
   {
    "text": "2025年，",
    "start": 0.419,
    "end": 1.076
   },
   {
    "text": "地块一做过一次规划调整：",
    "start": 1.389,
    "end": 3.996
   },
   {
    "text": "计容面积一平米没变，",
    "start": 4.12,
    "end": 5.74
   },
   {
    "text": "总户数少了104户。",
